+  {
+    LL_USART_Disable(UART5);
+  }
 
-  /* Disable USARTx_IRQn */
-  NVIC_DisableIRQ(UART5_IRQn);
+  if (uart5_clock_enabled_here && __HAL_RCC_UART5_IS_CLK_ENABLED())
+  {
