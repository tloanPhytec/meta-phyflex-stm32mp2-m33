+  (void) ResMgr_Release(RESMGR_RESOURCE_RIF_GPIOF, RESMGR_GPIO_PIN(11));
 
   /* Disable NVIC for EXTI15_10_IRQn */
   NVIC_DisableIRQ(USER2_BUTTON_EXTI_IRQn);
@@ -461,10 +487,18 @@ void MX_USART_Init(void)
   {
     Error_Handler();
   }
-  /* Enable GPIOs power supplies */
-  if (RESMGR_STATUS_ACCESS_OK == ResMgr_Request(RESMGR_RESOURCE_RIF_RCC, RESMGR_RCC_RESOURCE(96)))
+  /* Request RCC access only if the GPIOG clock needs to be enabled. */
+  if (!__HAL_RCC_GPIOG_IS_CLK_ENABLED())
   {
+    if (ResMgr_Request(RESMGR_RESOURCE_RIF_RCC, RESMGR_RCC_RESOURCE(96)) != RESMGR_STATUS_ACCESS_OK)
+    {
+      Error_Handler();
+    }
     LL_RCC_GPIOG_EnableClock();
+    if (!__HAL_RCC_GPIOG_IS_CLK_ENABLED())
+    {
+      Error_Handler();
+    }
   }
 
   /* Configure Tx Pin as : Alternate function, High Speed, Push pull, Pull up */
@@ -484,11 +518,26 @@ void MX_USART_Init(void)
   /* (2) NVIC Configuration for USART interrupts */
   /*  - Set priority for UART5_IRQn */
   /*  - Enable UART5_IRQn */
-  NVIC_SetPriority(UART5_IRQn, 0);
-  NVIC_EnableIRQ(UART5_IRQn);
+  //NVIC_SetPriority(UART5_IRQn, 0);
+  //NVIC_EnableIRQ(UART5_IRQn);
+
+  /* UART5 access was granted above. Leave an existing clock enable in place. */
+  if (!__HAL_RCC_UART5_IS_CLK_ENABLED())
+  {
+    LL_RCC_UART5_EnableClock();
+    if (!__HAL_RCC_UART5_IS_CLK_ENABLED())
+    {
+      Error_Handler();
+    }
+    uart5_clock_enabled_here = 1U;
+  }
 
-  /* (3) Enable USART peripheral clock and clock source ***********************/
-  LL_RCC_UART5_EnableClock();
+  /* A UART register access can fault while the peripheral is held in reset. */
+  if (READ_BIT(RCC->UART5CFGR, RCC_UART5CFGR_UART5RST) != 0U)
+  {
+    Error_Handler();
+  }
+  uart5_registers_ready = 1U;
 
   /* (4) Configure USART functional parameters ********************************/
 
@@ -528,8 +577,8 @@ void MX_USART_Init(void)
   }
 
   /* Enable RXNE and Error interrupts */
-  LL_USART_EnableIT_RXNE(UART5);
-  LL_USART_EnableIT_ERROR(UART5);
+  //LL_USART_EnableIT_RXNE(UART5);
+  //LL_USART_EnableIT_ERROR(UART5);
 }
 
