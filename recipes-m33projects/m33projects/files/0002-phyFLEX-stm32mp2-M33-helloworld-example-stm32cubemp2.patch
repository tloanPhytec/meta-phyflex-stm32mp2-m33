@@ -154,12 +158,34 @@ int main(void)
   MX_USART_Init();
 
   /* USER CODE BEGIN 2 */
+  static const uint8_t message[] = "Hello World\r\n";
+
+  // disable the default USART RX interrupt behavior
+  NVIC_DisableIRQ(UART5_IRQn);
+  LL_USART_DisableIT_RXNE(UART5);
+  LL_USART_DisableIT_ERROR(UART5);
+
+  uint32_t last = HAL_GetTick();
 
   /* Infinite loop */
   while (1)
   {
     /* USER CODE END WHILE */
 
+	  uint32_t now = HAL_GetTick();
+	  if ((uint32_t)(now - last) >= 3000U && printing)
+	  {
+		  last = now;
+		  LED_On();
+		  for (uint32_t i = 0U; i < (sizeof(message) - 1U); ++i)
+		  {
+			  /* Wait until UART5 can accept another byte. */
+			  while (!LL_USART_IsActiveFlag_TXE(UART5)){}
+			  LL_USART_TransmitData8(UART5, message[i]);
+		  }
+		  /* Wait for the last byte to finish transmitting. */
+		  while (!LL_USART_IsActiveFlag_TC(UART5)){}
+	  }
     /* USER CODE BEGIN 3 */
   }
   /* USER CODE END 3 */
