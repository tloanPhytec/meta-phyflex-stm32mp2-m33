@@ -539,14 +588,20 @@ void MX_USART_Init(void)
   */
 void MX_USART_DeInit(void)
 {
-  /* Disable USART */
-  LL_USART_Disable(UART5);
+  /* Disable USARTx_IRQn before accessing or gating the peripheral. */
+  NVIC_DisableIRQ(UART5_IRQn);
 
-  /* Disable USART peripheral clock */
-  LL_RCC_UART5_DisableClock();
+  if (uart5_registers_ready &&
+      READ_BIT(RCC->UART5CFGR, RCC_UART5CFGR_UART5EN | RCC_UART5CFGR_UART5RST) ==
