+  unsigned int rate_khz;
+  const char *step = "clock attributes";
+  int ret = scmi_clock_get_attributes(&scmi_channel, SPI2_SCMI_CLOCK_ID,
+                                      name, 16, &attributes);
+  if (ret != 0) goto failed;
+  if (strcmp(name, SPI2_SCMI_CLOCK_NAME) != 0) {
+    printf("SCMI: clock ID %u is '%s'; expected '%s'.\r\n",
+           SPI2_SCMI_CLOCK_ID, name, SPI2_SCMI_CLOCK_NAME);
+    return -1; /* No clock enable request was sent. */
+  }
+
+  step = "clock rate query";
+  ret = scmi_clock_get_rate(&scmi_channel, SPI2_SCMI_CLOCK_ID, &rate_khz);
+  if (ret != 0) goto failed;
+  if (rate_khz == 0U) {
+    printf("SCMI: source clock reports zero rate; check OP-TEE clock setup.\r\n");
+    return -1;
+  }
+  step = "clock enable";
+  ret = scmi_clock_enable(&scmi_channel, SPI2_SCMI_CLOCK_ID);
+  if (ret != 0) goto failed;
+  spi2_clock_held = 1U;
+  return 0;
+
+failed:
+  printf("SCMI: %s failed: %d\r\n", step, ret);
+  return ret;
+}
+
+static void RunLoopback(void)
+{
+  static uint32_t test_number;
+  static uint8_t recovery_needed;
+  if (recovery_needed)
+  {
+    if (RecoverSPI2() != HAL_OK)
+    {
+      BSP_LED_On(LED3);
+      printf("Recovery failed; press USER2 to retry recovery.\r\n");
+      return;
+    }
+    recovery_needed = 0;
+  }
+  ++test_number;
+  for (uint32_t i = 0; i < BUFFERSIZE; ++i)
+  {
+    aRxBuffer[i] = (uint8_t)~aTxBuffer[i];
+  }
+#ifdef ICACHE_DCACHE_ENABLE
+  /* Publish TX and discard dirty RX lines before DMA takes ownership. */
+  if (HAL_DCACHE_CleanByAddr(&hdcache, (const uint32_t *)aTxBuffer, sizeof(aTxBuffer)) != HAL_OK ||
+      HAL_DCACHE_CleanInvalidByAddr(&hdcache, (uint32_t *)aRxBuffer, sizeof(aRxBuffer)) != HAL_OK)
+    Error_Handler();
+#endif
+  printf("\r\nTest %lu: %u bytes, SPI mode 0\r\n",
+         (unsigned long)test_number, (unsigned)BUFFERSIZE);
+  wTransferState = TRANSFER_WAIT;
+  uint32_t start = HAL_GetTick();
+  HAL_StatusTypeDef status = HAL_SPI_TransmitReceive_DMA(
+      &SpiHandle, (uint8_t *)aTxBuffer, aRxBuffer, BUFFERSIZE);
+  while (status == HAL_OK && wTransferState == TRANSFER_WAIT &&
+         (HAL_GetTick() - start) < LOOPBACK_TIMEOUT_MS)
+  {
+    if (shutdown_requested) Shutdown();
+    /* DMA/SPI interrupts update wTransferState. */
+  }
+  if (status != HAL_OK || wTransferState != TRANSFER_COMPLETE)
+  {
+    BSP_LED_On(LED3);
+    printf("FAIL: SPI transfer failed or timed out.\r\n");
+    /* Stop DMA before any future buffer access; do not reuse a live transfer. */
+    if (HAL_SPI_Abort(&SpiHandle) != HAL_OK)
+    {
+      printf("Abort failed; recovering.\r\n");
+      recovery_needed = 1;
+      if (RecoverSPI2() != HAL_OK)
+      {
+        printf("Recovery failed; press USER2 to retry recovery.\r\n");
+        return;
+      }
+      recovery_needed = 0;
+    }
+    printf("Press USER2 to retry.\r\n");
+    return;
+  }
+#ifdef ICACHE_DCACHE_ENABLE
+  if (HAL_DCACHE_InvalidateByAddr(&hdcache, (uint32_t *)aRxBuffer, sizeof(aRxBuffer)) != HAL_OK)
+    Error_Handler();
+#endif
+  PrintBuffer("TX: ", aTxBuffer);
+  PrintBuffer("RX: ", aRxBuffer);
+  if (memcmp(aTxBuffer, aRxBuffer, BUFFERSIZE) != 0)
+  {
+    BSP_LED_On(LED3);
+    printf("FAIL: TX/RX mismatch. Check the loopback wire.\r\n");
+  }
+  else
+  {
+    BSP_LED_Off(LED3);
+    printf("PASS: all bytes match.\r\n");
+  }
+}
+
+static void PrintBuffer(const char *label, const uint8_t *data)
+{
+  printf("%s", label);
+  for (uint32_t i = 0; i < BUFFERSIZE; ++i)
+  {
+    printf("%02X ", (unsigned)data[i]);
+  }
+  printf("\r\n");
+}
+
+static HAL_StatusTypeDef RecoverSPI2(void)
+{
+  HAL_NVIC_DisableIRQ(SPI2_IRQn);
+  HAL_NVIC_DisableIRQ(HPDMA3_Channel2_IRQn);
+  HAL_NVIC_DisableIRQ(HPDMA3_Channel3_IRQn);
+  SPI2->IER = 0;
+  CLEAR_BIT(SPI2->CFG1, SPI_CFG1_TXDMAEN | SPI_CFG1_RXDMAEN);
+
+  HAL_StatusTypeDef tx = HAL_DMA_DeInit(SpiHandle.hdmatx);
+  HAL_StatusTypeDef rx = HAL_DMA_DeInit(SpiHandle.hdmarx);
+  if (tx != HAL_OK || rx != HAL_OK)
+    return HAL_ERROR;
+
+  __HAL_RCC_SPI2_FORCE_RESET();
+  __HAL_RCC_SPI2_RELEASE_RESET();
+  tx = HAL_DMA_Init(SpiHandle.hdmatx);
+  rx = HAL_DMA_Init(SpiHandle.hdmarx);
+  SpiHandle.hdmatx->Parent = &SpiHandle;
+  SpiHandle.hdmarx->Parent = &SpiHandle;
+  if (tx != HAL_OK || rx != HAL_OK)
+    return HAL_ERROR;
+
+  SpiHandle.State = HAL_SPI_STATE_ERROR;
+  SpiHandle.Lock = HAL_UNLOCKED;
+  if (HAL_SPI_Init(&SpiHandle) != HAL_OK)
+    return HAL_ERROR;
+
+  HAL_NVIC_ClearPendingIRQ(SPI2_IRQn);
+  HAL_NVIC_ClearPendingIRQ(HPDMA3_Channel2_IRQn);
+  HAL_NVIC_ClearPendingIRQ(HPDMA3_Channel3_IRQn);
+  HAL_NVIC_EnableIRQ(SPI2_IRQn);
+  HAL_NVIC_EnableIRQ(HPDMA3_Channel2_IRQn);
+  HAL_NVIC_EnableIRQ(HPDMA3_Channel3_IRQn);
+  return HAL_OK;
+}
