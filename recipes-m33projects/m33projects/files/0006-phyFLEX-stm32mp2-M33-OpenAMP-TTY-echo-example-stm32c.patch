 .../CM33/NonSecure/Core/Src/main.c            | 22 +++++++++++++------
 .../STM32CubeIDE/CM33/NonSecure/.cproject     |  4 ++--
 2 files changed, 17 insertions(+), 9 deletions(-)

diff --git a/Projects/STM32MP257F-EV1/Applications/OpenAMP/OpenAMP_TTY_echo/CM33/NonSecure/Core/Src/main.c b/Projects/STM32MP257F-EV1/Applications/OpenAMP/OpenAMP_TTY_echo/CM33/NonSecure/Core/Src/main.c
index 0c03caa..4d09c8d 100644
