+++ b/Projects/STM32MP257F-EV1/Applications/OpenAMP/OpenAMP_TTY_echo/CM33/NonSecure/Core/Src/main.c
@@ -107,7 +107,7 @@ int main(void)
   BSP_LED_Init(LED3);
   BSP_LED_On(LED3);
 
-  loc_printf ("\r\n Starting OpenAMP application (%s: %s) \r\n", __DATE__, __TIME__);
+  loc_printf ("\r\nStarting OpenAMP application (%s: %s) \r\n", __DATE__, __TIME__);
 
   /* IPCC initialisation */
   MX_IPCC_Init();
@@ -211,23 +211,31 @@ static void MX_IPCC_Init(void)
 
 void VIRT_UART0_RxCpltCallback(VIRT_UART_HandleTypeDef *huart)
 {
+    static const char prefix[] = "M33 Responds: ";
+    const uint16_t maxInputSize = RPMSG_BUFFER_SIZE - 16U - (sizeof(prefix) - 1U);
 
-    loc_printf("Msg received on VIRTUAL UART0 channel:  %s \n\r", (char *) huart->pRxBuffPtr);
+    loc_printf("%.*s\r", (int)huart->RxXferSize, (char *)huart->pRxBuffPtr);
 
     /* copy received msg in a variable to sent it back to master processor in main infinite loop*/
-    VirtUart0ChannelRxSize = huart->RxXferSize < MAX_BUFFER_SIZE? huart->RxXferSize : MAX_BUFFER_SIZE-1;
-    memcpy(VirtUart0ChannelBuffRx, huart->pRxBuffPtr, VirtUart0ChannelRxSize);
+    VirtUart0ChannelRxSize = huart->RxXferSize < maxInputSize ? huart->RxXferSize : maxInputSize;
+    memcpy(VirtUart0ChannelBuffRx, prefix, sizeof(prefix) - 1U);
+    memcpy(VirtUart0ChannelBuffRx + sizeof(prefix) - 1U, huart->pRxBuffPtr, VirtUart0ChannelRxSize);
+    VirtUart0ChannelRxSize += sizeof(prefix) - 1U;
     VirtUart0RxMsg = SET;
 }
 
 void VIRT_UART1_RxCpltCallback(VIRT_UART_HandleTypeDef *huart)
 {
+    static const char prefix[] = "M33 Responds: ";
+    const uint16_t maxInputSize = RPMSG_BUFFER_SIZE - 16U - (sizeof(prefix) - 1U);
 
-    loc_printf("Msg received on VIRTUAL UART1 channel:  %s \n\r", (char *) huart->pRxBuffPtr);
+    loc_printf("%.*s\r", (int)huart->RxXferSize, (char *)huart->pRxBuffPtr);
 
     /* copy received msg in a variable to sent it back to master processor in main infinite loop*/
-    VirtUart1ChannelRxSize = huart->RxXferSize < MAX_BUFFER_SIZE? huart->RxXferSize : MAX_BUFFER_SIZE-1;
-    memcpy(VirtUart1ChannelBuffRx, huart->pRxBuffPtr, VirtUart1ChannelRxSize);
+    VirtUart1ChannelRxSize = huart->RxXferSize < maxInputSize ? huart->RxXferSize : maxInputSize;
+    memcpy(VirtUart1ChannelBuffRx, prefix, sizeof(prefix) - 1U);
+    memcpy(VirtUart1ChannelBuffRx + sizeof(prefix) - 1U, huart->pRxBuffPtr, VirtUart1ChannelRxSize);
+    VirtUart1ChannelRxSize += sizeof(prefix) - 1U;
     VirtUart1RxMsg = SET;
 }
 
