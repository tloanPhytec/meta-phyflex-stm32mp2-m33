+static void UART5_Print(const char *text)
+{
+  uint32_t start = HAL_GetTick();
+  while (*text)
+  {
+    while (!LL_USART_IsActiveFlag_TXE(UART5))
+      if (HAL_GetTick() - start >= 100U) Error_Handler();
+    LL_USART_TransmitData8(UART5, (uint8_t)*text++);
+  }
+  while (!LL_USART_IsActiveFlag_TC(UART5))
+    if (HAL_GetTick() - start >= 100U) Error_Handler();
+}
