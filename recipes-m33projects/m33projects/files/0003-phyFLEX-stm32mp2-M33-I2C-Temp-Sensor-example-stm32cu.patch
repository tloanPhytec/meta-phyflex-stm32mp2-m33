+/* Same UART5 pins and baud configuration as the verified USART example. */
+static void UART5_Init(void)
+{
+  /* Inspect these variables in the debugger if a request fails. */
+  static volatile ResMgr_Status_t uart_status;
+  static volatile ResMgr_Status_t pg9_status;
+  static volatile ResMgr_Status_t pg10_status;
+  static volatile ResMgr_Status_t clock_status;
+
+  uart_status = ResMgr_Request(
+      RESMGR_RESOURCE_RIFSC, STM32MP25_RIFSC_UART5_ID);
+  if (uart_status != RESMGR_STATUS_ACCESS_OK)
+    Error_Handler();
+
+  pg9_status = ResMgr_Request(
+      RESMGR_RESOURCE_RIF_GPIOG, RESMGR_GPIO_PIN(9));
+  if (pg9_status != RESMGR_STATUS_ACCESS_OK)
+    Error_Handler();
+
+  pg10_status = ResMgr_Request(
+      RESMGR_RESOURCE_RIF_GPIOG, RESMGR_GPIO_PIN(10));
+  if (pg10_status != RESMGR_STATUS_ACCESS_OK)
+    Error_Handler();
+
+  /* Match the working USART example: only enable the clock if permitted. */
+  clock_status = ResMgr_Request(
+      RESMGR_RESOURCE_RIF_RCC, RESMGR_RCC_RESOURCE(96));
+  if (clock_status == RESMGR_STATUS_ACCESS_OK)
+    __HAL_RCC_GPIOG_CLK_ENABLE();
+
+  GPIO_InitTypeDef gpio = {0};
+  gpio.Pin = GPIO_PIN_9 | GPIO_PIN_10;
+  gpio.Mode = GPIO_MODE_AF_PP;
+  gpio.Pull = GPIO_PULLUP;
+  gpio.Speed = GPIO_SPEED_FREQ_HIGH;
+  gpio.Alternate = GPIO_AF5_UART5;
+  HAL_GPIO_Init(GPIOG, &gpio);
+
+  __HAL_RCC_UART5_CLK_ENABLE();
+  LL_USART_Disable(UART5);
+  LL_USART_SetTransferDirection(UART5, LL_USART_DIRECTION_TX_RX);
+  LL_USART_ConfigCharacter(UART5, LL_USART_DATAWIDTH_8B,
+                           LL_USART_PARITY_NONE, LL_USART_STOPBITS_1);
+  LL_USART_SetHWFlowCtrl(UART5, LL_USART_HWCONTROL_NONE);
+  LL_USART_SetOverSampling(UART5, LL_USART_OVERSAMPLING_8);
+  LL_USART_SetBaudRate(UART5, HAL_RCCEx_GetPeriphCLKFreq(RCC_PERIPHCLK_UART3_5),
+                      LL_USART_PRESCALER_DIV1, LL_USART_OVERSAMPLING_8, 115200);
+  NVIC_DisableIRQ(UART5_IRQn);
+  LL_USART_DisableIT_RXNE(UART5);
+  LL_USART_DisableIT_ERROR(UART5);
+  LL_USART_Enable(UART5);
+}
